# Скопируйте в .env и подставьте значения (файл .env в git не коммитится)

# На продакшене обязательно задать свой ключ (не коммитить в git):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Локальная разработка: 1 или true — включит DEBUG, подробные ошибки Django
DJANGO_DEBUG=0

# Доступ с телефона по Wi‑Fi (IP из ipconfig), через запятую
# DJANGO_ALLOWED_HOSTS=192.168.1.105

# CSRF для форм с телефона: http://IP:8000
# DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.105:8000

# --- База данных (PostgreSQL) ---
# По умолчанию Postgres: localhost:5432, база/пользователь temina.
# На сервере обязательно задать свой DB_PASSWORD.
# DB_NAME=temina
# DB_USER=temina
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# Экстренный откат на старый db.sqlite3:
# DB_ENGINE=sqlite

# AI (опционально)
# OPENAI_API_KEY=
# GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# RevenueCat (подписка TeminaFit Pro)
# REVENUECAT_WEBHOOK_AUTH=   # тот же секрет, что в Authorization заголовке вебхука RC
# REVENUECAT_SECRET_API_KEY= # Secret API key из дашборда RevenueCat
# REVENUECAT_PRO_ENTITLEMENT=pro

# --- Email / Resend (soft verification) ---
# Django шлёт через SMTP Resend (не Node SDK).
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_xxxxxxxx   # API key из https://resend.com/api-keys
# From ТОЛЬКО с верифицированного домена Resend.
# Если в Resend добавлен subdomain noreply.temina.fit:
# DEFAULT_FROM_EMAIL=Temina <hello@noreply.temina.fit>
# PUBLIC_BASE_URL=https://temina.fit
#
# onboarding@resend.dev — только тест, и обычно только на email аккаунта Resend.

# --- TWA (Android «приложение» через Chrome) ---
# После: npx @bubblewrap/cli init (укажите URL https://temina.fit)
# Возьмите package name из android/app/build.gradle и SHA-256 подписи:
#   keytool -list -v -keystore ~/.android/debug.keystore -alias androiddebugkey -storepass android -keypass android
#   (для release — ваш upload keystore)
# Несколько отпечатков через запятую (debug + release).
TWA_ANDROID_PACKAGE_NAME=fit.temina.app
TWA_SHA256_CERT_FINGERPRINTS=B6:FA:87:56:E8:5A:31:FF:BD:36:CD:EB:E5:51:86:87:72:DB:23:83:DA:8D:50:9E:49:D0:0A:75:1C:A3:7C:3D

# Cloudflare Turnstile — тихая капча на /register/.
# dash.cloudflare.com → Turnstile → Add widget, домены temina.fit и www.temina.fit, режим Managed.
# Без этих двух ключей на проде форма регистрации закрыта.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
