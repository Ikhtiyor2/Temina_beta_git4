{
  "rulesVersion": 4,
  "locale": "en",
  "antiCheat": {
    "minTrackedFrameRatio": 0.65,
    "maxRepsPerMinute": 45,
    "minRepDurationMs": 600,
    "maxBodyCenterShiftPerFrame": 0.09
  },
  "exercises": [
    {
      "id": "dumbbell_curl_bicep",
      "rules": [
        {
          "id": "curl_elbow_forward",
          "phase": "down",
          "metric": "elbow_forward_px",
          "dangerAbove": 28,
          "severity": "CRITICAL",
          "blockRep": true,
          "message": "Elbows drifting forward",
          "hint": "Pin your elbows to your torso — safer for shoulders and better biceps work",
          "healthTighten": [
            "shoulders"
          ]
        },
        {
          "id": "curl_jerk",
          "phase": "any",
          "metric": "angle_velocity_deg_per_frame",
          "dangerAbove": 22,
          "severity": "CRITICAL",
          "blockRep": true,
          "message": "Jerking the movement",
          "hint": "Lower the weight and slow down — jerks increase injury risk"
        },
        {
          "id": "curl_asymmetry",
          "phase": "any",
          "metric": "elbow_asymmetry_deg",
          "warnAbove": 25,
          "severity": "WARNING",
          "blockRep": false,
          "message": "Uneven arm work",
          "hint": "Sync both arms"
        }
      ]
    },
    {
      "id": "dumbbell_hammer_curl",
      "rules": [
        {
          "id": "hammer_elbow_forward",
          "phase": "down",
          "metric": "elbow_forward_px",
          "dangerAbove": 30,
          "severity": "CRITICAL",
          "blockRep": true,
          "message": "Elbows drifting forward",
          "hint": "Keep elbows at your sides in hammer grip",
          "healthTighten": [
            "shoulders"
          ]
        },
        {
          "id": "hammer_jerk",
          "phase": "any",
          "metric": "angle_velocity_deg_per_frame",
          "dangerAbove": 22,
          "severity": "CRITICAL",
          "blockRep": true,
          "message": "Jerk",
          "hint": "Control the tempo"
        }
      ]
    },
    {
