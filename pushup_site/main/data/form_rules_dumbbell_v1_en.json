    {
      "id": "pullup_classic",
      "rules": [
        {
          "id": "pullup_jerk",
          "phase": "any",
          "metric": "angle_velocity_deg_per_frame",
          "dangerAbove": 16,
          "severity": "CRITICAL",
          "blockRep": true,
          "message": "Sudden movement",
          "hint": "Pull up smoothly — jerks and kipping don\\'t count",
          "healthTighten": []
        },
        {
          "id": "pullup_kip",
          "phase": "any",
          "metric": "body_center_shift_norm",
          "dangerAbove": 0.08,
          "severity": "CRITICAL",
