          "id": "pullup_no_body_rise",
          "phase": "down",
          "metric": "body_rise_px",
          "dangerBelow": 22,
          "severity": "CRITICAL",
          "blockRep": true,
          "message": "Body not rising",
          "hint": "Pull shoulders and chin up — wrists stay in place",
          "healthTighten": []
        },
