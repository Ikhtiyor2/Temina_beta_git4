            "back"
          ]
        },
        {
          "id": "press_jerk",
          "phase": "any",
          "metric": "angle_velocity_deg_per_frame",
          "dangerAbove": 24,
          "severity": "CRITICAL",
          "blockRep": true,
          "message": "Press jerk",
          "hint": "Press smoothly"
        }
      ]
    },
    {
