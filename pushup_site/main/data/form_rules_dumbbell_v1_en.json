          "id": "row_jerk",
          "phase": "any",
          "metric": "angle_velocity_deg_per_frame",
          "dangerAbove": 22,
          "severity": "CRITICAL",
          "blockRep": true,
          "message": "Row jerk",
          "hint": "Pull elbow to hip smoothly"
